              <span style={{ fontSize: "9px", color: "#aaa", textAlign: "center" }}>QR Code</span>
            )}
          </div>

          {/* Scan to Verify */}
          <div style={{
            fontSize: "9px", color: "#666",
            letterSpacing: "0.3px", marginBottom: "4px", flexShrink: 0,
