              height: "22px", display: "flex",
              alignItems: "center", justifyContent: "center",
              marginBottom: "2px",
            }}>
              {/* eslint-disable-next-line @next/next/no-img-element */}
              <img
                src="/signature.png"
                alt="Signature"
                style={{ height: "22px", width: "auto", maxWidth: "88px", objectFit: "contain" }}
              />
            </div>
            <div style={{ height: "1px", background: "#aaa", margin: "0 18px 3px" }} />
            <div style={{ fontSize: "11px", fontWeight: 800, color: "#111", letterSpacing: "0.5px", lineHeight: 1.2 }}>
