        {/* LEFT 415px */}
        <div style={{
          width: "415px",
          flexShrink: 0,
          padding: "5px 12px 5px 18px",
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-around",
        }}>
          {rows.map(([key, val], i) => (
            <div key={key} style={{
              display: "flex", alignItems: "center",
              borderBottom: i < rows.length - 1 ? "1px solid #ebebeb" : "none",
              padding: "3px 0",
